# Forge — environment contract (copy to .env.local; none required for the mock prototype)
# These wire M1 (live auth + data) and the AI/billing seams. The app runs fully on
# mock data with all of these unset.

# --- Supabase (auth, Postgres, storage, realtime) --------------------------
# Create a project at https://supabase.com, run supabase/migrations/0001_forge_init.sql,
# then paste the values from Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only (Edge Functions / route handlers). NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI Coach (server-only; called from a Supabase Edge Function / route handler) ---
# The key must never reach the browser. Model: claude-opus-4-8.
ANTHROPIC_API_KEY=

# --- Billing (Stripe) ------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Price IDs for the tiers (Forge Pro / Forge Elite)
STRIPE_PRICE_PRO=
STRIPE_PRICE_ELITE=

# --- Marketing site (waitlist + beta) --------------------------------------
# The waitlist/beta API routes insert into Supabase from the SERVER only, using a
# secret key that bypasses RLS. Set SUPABASE_URL (or reuse NEXT_PUBLIC_SUPABASE_URL
# above) plus a secret key, then run supabase/migrations/0004_marketing.sql.
# With these unset, submissions are validated and logged (mock mode) — the whole
# funnel works locally with zero backend.
SUPABASE_URL=
# Preferred: the new Supabase Secret key (starts with sb_secret_).
# Settings → API Keys → Secret keys → Reveal. NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# The legacy SUPABASE_SERVICE_ROLE_KEY (above) still works as a fallback if set.

# --- Analytics (all optional; a provider activates only when its ID is set) --
# No fake IDs — leave blank to disable. See src/lib/analytics.ts.
NEXT_PUBLIC_GA_ID=            # Google Analytics 4, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=    # Meta / Facebook Pixel ID
NEXT_PUBLIC_TIKTOK_PIXEL_ID=  # TikTok Pixel ID

# --- App ------------------------------------------------------------------
# Base URL the typed client SDK targets (lets a native client reuse the same API).
# Also used as the canonical/OG base URL for the marketing site.
NEXT_PUBLIC_APP_URL=http://localhost:3000
